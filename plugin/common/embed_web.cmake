# Build-time script: turns the files of the built page (plugin/web/dist) into one C++ source with a table of (path, bytes).
# Run as: cmake -DSRC_DIR=<plugin/web/dist> -DOUT=<file.cpp> -DFILES=<a|b|c> -P embed_web.cmake
# FILES are paths relative to SRC_DIR separated by '|'. The output depends only on the file names and bytes
# (no dates), so the same input gives the same file.
if(NOT SRC_DIR OR NOT OUT OR NOT FILES)
    message(FATAL_ERROR "embed_web.cmake: SRC_DIR, OUT and FILES are required")
endif()
string(REPLACE "|" ";" file_list "${FILES}")
list(SORT file_list)
set(body "// Generated by plugin/common/embed_web.cmake from plugin/web/dist. Do not edit.\n#include \"WebAssetTable.h\"\n\nnamespace lesson_web {\nnamespace {\n")
set(table "")
set(i 0)
foreach(rel IN LISTS file_list)
    file(READ "${SRC_DIR}/${rel}" hex HEX)
    string(LENGTH "${hex}" hex_length)
    math(EXPR size "${hex_length} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n" bytes "${bytes}")
    # One spare byte so that an empty file still gives a valid array.
    string(APPEND body "const unsigned char kData${i}[] = {\n${bytes}0x00};\n")
    string(APPEND table "    { \"${rel}\", kData${i}, ${size} },\n")
    math(EXPR i "${i} + 1")
endforeach()
string(APPEND body "}\nextern const Asset kAssets[] = {\n${table}};\nextern const int kAssetCount = ${i};\n}\n")
file(WRITE "${OUT}" "${body}")
